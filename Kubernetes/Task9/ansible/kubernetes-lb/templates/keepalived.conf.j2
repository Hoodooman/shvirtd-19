vrrp_script chk_haproxy {
  script "killall -0 haproxy"
  interval 2
  weight 2
}

vrrp_instance VI_1 {
  interface {{ network_interface }}
  state {{ control_nodes[inventory_hostname].state }}
  virtual_router_id {{ virtual_router_id }}
  priority {{ control_nodes[inventory_hostname].priority }}
  
  virtual_ipaddress {
    {{ cluster_vip }}/{{ cluster_vip_netmask }}
  }

  track_script {
    chk_haproxy
  }
}